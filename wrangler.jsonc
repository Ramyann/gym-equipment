{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bos-strength",
  // The Worker serves /api/* (AI part lookup, server/index.ts); everything else is the static site in dist/.
  "main": "server/index.ts",
  "compatibility_date": "2026-09-17",
  // Deploys to <name>.<your-subdomain>.workers.dev. Your own domain (on your Cloudflare account):
  // "routes": [{ "pattern": "gym.example.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // AI lookups per UTC day for the whole site (they all use your AI key). Secrets (never commit):
  // OPENROUTER_API_KEY or ANTHROPIC_API_KEY, and optionally GITHUB_TOKEN — see docs/ai-parts.md.
  "vars": { "DAILY_LIMIT": "100", "GITHUB_REPO": "Ramyann/gym-equipment" }
  // Quotas and the lookup cache: create a KV namespace (npx wrangler kv namespace create PARTS_KV) and uncomment:
  // ,"kv_namespaces": [{ "binding": "PARTS_KV", "id": "<id from the command above>" }]
}
