{
  "name": "bos-strength",
  "version": "0.0.1",
  "description": "BOS STRENGTH parametric rack and equipment models",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "npm --prefix ../gym-studio-backend run dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "test": "tsx --test --test-concurrency=2 rack-generator/*.test.ts src/**/*.test.ts",
    "thumbnails": "tsx scripts/generate-thumbnails.ts",
    "test:logos:browser": "playwright test e2e/logos.spec.ts --workers=1",
    "dev:studio": "npm --prefix ../gym-studio-backend run dev",
    "dev:studio:local": "npm --prefix ../gym-studio-backend run dev",
    "test:studio": "npm --prefix ../gym-studio-backend run test:studio",
    "test:api": "npm --prefix ../gym-studio-backend test",
    "start": "vite preview --host 127.0.0.1 --port 5173",
    "backend:sync": "npm --prefix ../gym-studio-backend run contracts:sync",
    "backend:check": "npm --prefix ../gym-studio-backend run contracts:check",
    "backend:export": "npm run backend:sync"
  },
  "keywords": [],
  "author": "Wes Bos (https://wesbos.com/)",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@tanstack/react-router": "^1.170.38",
    "@xmldom/xmldom": "^0.9.12",
    "fflate": "^0.8.3",
    "manifold-3d": "3.5.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.186.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "draco3dgltf": "^1.5.7",
    "esbuild-wasm": "^0.27.7",
    "fast-xml-parser": "^5.11.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
