{
  "name": "bos-strength",
  "version": "0.0.1",
  "description": "BOS STRENGTH parametric rack and equipment models",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "npm --prefix ../gym-studio-backend run dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "deploy": "node scripts/deploy-studio.mjs",
    "deploy:cloudflare:legacy": "npm run build && wrangler deploy",
    "test": "tsx --test --test-concurrency=2 rack-generator/*.test.ts src/**/*.test.ts server/server.test.ts server/studio.test.ts server/parts-api.test.ts",
    "thumbnails": "tsx scripts/generate-thumbnails.ts",
    "test:logos:browser": "playwright test e2e/logos.spec.ts --workers=1",
    "dev:studio": "npm --prefix ../gym-studio-backend run dev",
    "dev:studio:local": "npm --prefix ../gym-studio-backend run dev",
    "test:studio": "tsx --test server/studio.test.ts src/cloud/sync-engine.test.ts src/state/gym-designs.test.ts src/state/custom-parts.test.ts src/pages/routes.test.ts",
    "start": "vite preview --host 127.0.0.1 --port 5173",
    "backend:export": "node scripts/export-backend.mjs"
  },
  "keywords": [],
  "author": "Wes Bos (https://wesbos.com/)",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@tanstack/react-router": "^1.170.38",
    "@xmldom/xmldom": "^0.9.12",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "manifold-3d": "^3.5.3",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "draco3dgltf": "^1.5.7",
    "esbuild-wasm": "^0.27.7",
    "fast-xml-parser": "^5.11.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "wrangler": "^4.134.0"
  }
}
