server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  client_max_body_size 11m;
  server_tokens off;
  client_body_timeout 60s;
  # Manifold's Emscripten bindings generate functions in both catalog and geometry contexts.
  # Evaluation is required by that dependency; inline scripts and external script origins remain blocked.
  set $studio_csp "default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'";
  # Set this to the actual trusted Coolify ingress IP/CIDR in production.
  set_real_ip_from ${STUDIO_TRUSTED_PROXY_CIDR};
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
  add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "$studio_csp" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
  location = /healthz { access_log off; return 200 'ok'; }
  location /api/ {
    resolver 127.0.0.11 ipv6=off valid=10s;
    set $studio_upstream "${STUDIO_API_UPSTREAM}";
    proxy_pass $studio_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    proxy_connect_timeout 10s;
  }
  location /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "$studio_csp" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
  }
  # Manifold's Emscripten bindings use Function() inside geometry workers.
  # Worker responses also need their own policy because they execute independently.
  location ~ ^/assets/(library|logo|print)-worker-[A-Za-z0-9_-]+\.js$ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval'; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
  }
  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache";
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "$studio_csp" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
  }
}
