# Legacy Cloudflare Worker settings only. Studio uses ../gym-studio-backend/.env.
# To run this legacy Worker directly, use npx wrangler dev --port 8787.
# In production set these as secrets: npx wrangler secret put OPENROUTER_API_KEY (or ANTHROPIC_API_KEY)

# "openrouter" or "anthropic" for real research, or "mock" to try the flow without a key.
AI_PROVIDER=mock

# OpenRouter (cheapest): Claude Haiku 5.5 with OpenRouter's Parallel web search by default.
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# AI_MODEL=anthropic/claude-haiku-5.5
# Search engine: parallel (cheapest), exa, native (the model's own search) or auto.
# AI_SEARCH_ENGINE=parallel
# AI_MAX_SEARCHES=4

# Or Anthropic directly (default model claude-sonnet-5-5; claude-haiku-5-5 is cheaper).
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-haiku-5-5

# Optional, for "Request full catalog part" (the button appears when this is set): a fine-grained GitHub token
# with Issues read/write on the repo.
# GITHUB_TOKEN=github_pat_...
# GITHUB_REPO=Ramyann/gym-equipment

# AI lookups per day for the whole site (every lookup uses your AI key). Default 100.
# DAILY_LIMIT=100
